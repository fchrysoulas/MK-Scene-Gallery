<div class="mg-wrap mg-title-size-{{imageTitleFontSize}}">
  <header class="mg-toolbar">
    <div class="mg-toolbar-actions" aria-label="Gallery actions">
      <button
        type="button"
        data-action="pick-folder"
        title="Choose which Foundry data folder to browse"
        aria-label="Choose gallery folder"
      >
        <i class="fas fa-folder-open" aria-hidden="true"></i>
        <span class="sr-only">Choose folder</span>
      </button>

      <button
        type="button"
        data-action="add-image"
        title="Upload images to the selected folder"
        aria-label="Add images"
      >
        <i class="fas fa-upload" aria-hidden="true"></i>
        <span class="sr-only">Add images</span>
      </button>

      <button
        type="button"
        data-action="remove-token-layer-image"
        title="{{sceneData.tokenLayerRemoveTitle}}"
        aria-label="Remove scene image"
        {{#if sceneData.tokenLayerRemoveDisabled}}disabled{{/if}}
      >
        <i class="fas fa-eraser" aria-hidden="true"></i>
        <span class="sr-only">Remove scene image</span>
      </button>

      <button
        type="button"
        data-action="refresh-gallery"
        title="Rebuild the gallery index"
        aria-label="Refresh gallery"
      >
        <i class="fas fa-rotate-right" aria-hidden="true"></i>
        <span class="sr-only">Refresh</span>
      </button>

      <label
        class="mg-toolbar-grid {{#if sceneData.gridDisabled}}is-disabled{{/if}}"
        title="{{sceneData.gridTitle}}"
      >
        <i class="fas fa-border-all" aria-hidden="true"></i>
        <span class="sr-only">Grid size in pixels</span>
        <input
          type="range"
          data-role="grid-size"
          min="{{sceneData.gridSizeMin}}"
          max="{{sceneData.gridSizeMax}}"
          step="{{sceneData.gridSizeStep}}"
          value="{{sceneData.gridSizeValue}}"
          aria-label="Grid size in pixels"
          {{#if sceneData.gridDisabled}}disabled{{/if}}
        >
        <span class="mg-grid-size-reading">
          <output data-role="grid-size-value">{{sceneData.gridSize}}</output>
          <small>px</small>
        </span>
      </label>

      <button
        type="button"
        class="mg-toolbar-fix"
        data-action="fix-bounds"
        title="{{sceneData.fixTitle}}"
        aria-label="Fix scene bounds"
        {{#if sceneData.fixDisabled}}disabled{{/if}}
      >
        <i class="fas fa-crosshairs" aria-hidden="true"></i>
        <span class="sr-only">Fix Bounds</span>
      </button>

      {{#if sceneData.lockViewBounds.available}}
        <div class="mg-toolbar-bounds" title="{{sceneData.lockViewBounds.title}}">
          <span>
            <i class="fas fa-vector-square" aria-hidden="true"></i>
            Bounding Box
          </span>
          <select
            data-role="lockview-anchor"
            data-drawing-id="{{sceneData.lockViewBounds.drawingId}}"
            aria-label="Bounding Box anchor"
            {{#if sceneData.lockViewBounds.disabled}}disabled{{/if}}
          >
            {{#each sceneData.lockViewBounds.options as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                {{option.label}}
              </option>
            {{/each}}
          </select>
        </div>
      {{/if}}
    </div>

    <label class="mg-toggle">
      <input type="checkbox" data-role="toggle-recursive" {{#if recursive}}checked{{/if}}>
      <span>Include subfolders</span>
    </label>
  </header>

  <div class="mg-browser {{#if selectedImage}}has-inspector{{/if}}">
    {{#if isIndexing}}
      <div class="mg-loading-overlay" aria-live="polite">
        <div class="mg-spinner" role="status" aria-label="Indexing media"></div>
        <div class="mg-loading-text">
          Indexing media… {{indexStats.foundFiles}} files in {{indexStats.scannedDirs}} folders
        </div>
      </div>
    {{else if isUploading}}
      <div class="mg-loading-overlay" aria-live="polite">
        <div class="mg-spinner" role="status" aria-label="Uploading media"></div>
        <div class="mg-loading-text">Uploading images…</div>
      </div>
    {{/if}}

    {{#*inline "folderTreeNode"}}
      <li class="mg-tree-node">
        <div class="mg-tree-row {{#if selected}}is-active{{/if}}">
          {{#if children.length}}
            <button
              type="button"
              class="mg-tree-toggle"
              data-action="toggle-folder"
              data-folder="{{fullPath}}"
              aria-label="{{#if open}}Collapse{{else}}Expand{{/if}} {{label}}"
              aria-expanded="{{#if open}}true{{else}}false{{/if}}"
            >
              <i class="fas {{#if open}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i>
            </button>
          {{else}}
            <span class="mg-tree-spacer" aria-hidden="true"></span>
          {{/if}}

          <button
            type="button"
            class="mg-tree-folder"
            data-action="select-folder"
            data-folder="{{fullPath}}"
            title="{{fullPath}}"
            {{#if selected}}aria-current="page"{{/if}}
          >
            <i class="fas {{#if selected}}fa-folder-open{{else}}fa-folder{{/if}}" aria-hidden="true"></i>
            <span class="mg-tree-label">{{label}}</span>
            <span class="mg-tree-count" title="{{totalCount}} in this branch; {{fileCount}} directly in this folder">{{totalCount}}</span>
          </button>

          <button
            type="button"
            class="mg-tree-pin {{#if pinned}}is-pinned{{/if}}"
            data-action="toggle-pin-folder"
            data-folder="{{fullPath}}"
            title="{{#if pinned}}Unpin{{else}}Pin{{/if}} {{label}}"
            aria-label="{{#if pinned}}Unpin{{else}}Pin{{/if}} {{label}}"
            aria-pressed="{{#if pinned}}true{{else}}false{{/if}}"
          >
            <i class="fas fa-thumbtack" aria-hidden="true"></i>
          </button>
        </div>

        {{#if children.length}}
          <ul class="mg-tree-children {{#unless open}}is-collapsed{{/unless}}">
            {{#each children}}
              {{> folderTreeNode}}
            {{/each}}
          </ul>
        {{/if}}
      </li>
    {{/inline}}

    <aside class="mg-sidebar" aria-label="Folder navigation">
      <div class="mg-sidebar-heading">
        <span>Folders</span>
        <span class="mg-sidebar-total">{{totalIndexed}}</span>
      </div>

      <div class="mg-tree-scroll">
        {{#if pinnedFolders.length}}
          <section class="mg-pinned-section" aria-label="Pinned folders">
            <div class="mg-pinned-heading">
              <span><i class="fas fa-thumbtack" aria-hidden="true"></i> Pinned</span>
              <span>{{pinnedFolders.length}}</span>
            </div>
            <ul class="mg-pinned-list">
              {{#each pinnedFolders as |folder|}}
                <li class="mg-pinned-row {{#if folder.selected}}is-active{{/if}}">
                  <button
                    type="button"
                    class="mg-pinned-folder"
                    data-action="select-folder"
                    data-folder="{{folder.fullPath}}"
                    title="{{folder.fullPath}}"
                    {{#if folder.selected}}aria-current="page"{{/if}}
                  >
                    <i class="fas fa-folder" aria-hidden="true"></i>
                    <span class="mg-tree-label">{{folder.label}}</span>
                    <span class="mg-tree-count">{{folder.totalCount}}</span>
                  </button>
                  <button
                    type="button"
                    class="mg-pinned-remove"
                    data-action="toggle-pin-folder"
                    data-folder="{{folder.fullPath}}"
                    title="Unpin {{folder.label}}"
                    aria-label="Unpin {{folder.label}}"
                  >
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                  </button>
                </li>
              {{/each}}
            </ul>
          </section>
          <div class="mg-tree-divider" aria-hidden="true"></div>
        {{/if}}

        <button
          type="button"
          class="mg-tree-root {{#if tree.selected}}is-active{{/if}}"
          data-action="select-folder"
          data-folder="{{tree.fullPath}}"
          title="Show images from every indexed folder"
          {{#if tree.selected}}aria-current="page"{{/if}}
        >
          <i class="fas fa-images" aria-hidden="true"></i>
          <span class="mg-tree-label">All media</span>
          <span class="mg-tree-count">{{tree.totalCount}}</span>
        </button>

        {{#if tree.children.length}}
          <ul class="mg-tree mg-tree-top">
            {{#each tree.children}}
              {{> folderTreeNode}}
            {{/each}}
          </ul>
        {{/if}}
      </div>

      <div class="mg-sidebar-path" title="{{baseDir}}">
        <i class="fas fa-database" aria-hidden="true"></i>
        <span>{{baseDir}}</span>
      </div>
    </aside>

    <main class="mg-content">
      <div class="mg-content-header">
        <div class="mg-location">
          <div class="mg-location-title">
            <i class="fas {{#if tree.selected}}fa-images{{else}}fa-folder-open{{/if}}" aria-hidden="true"></i>
            <h2>{{activeFolderLabel}}</h2>
          </div>
          <div class="mg-location-path" title="{{activeFolderPath}}">{{activeFolderPath}}</div>
        </div>

        <label class="mg-search">
          <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
          <span class="sr-only">Search images</span>
          <input
            type="search"
            value="{{filter}}"
            placeholder="Search this folder"
            data-role="search"
            autocomplete="off"
          >
          {{#if filter}}
            <button type="button" data-action="clear-search" aria-label="Clear search" title="Clear search">
              <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
          {{/if}}
        </label>
      </div>

      <div class="mg-gallery-scroll">
        {{#*inline "thumbCard"}}
          <article
            class="mg-thumb {{#if (lookup @root.selectedMap path)}}is-selected{{/if}}"
            data-path="{{path}}"
            title="{{path}}"
            tabindex="0"
          >
            <div class="mg-thumb-img">
              <img class="mg-img" src="{{url}}" alt="{{label}}" loading="lazy">
              <div class="mg-hover-actions">
                <button
                  type="button"
                  class="mg-action"
                  data-action="add-to-token-layer"
                  data-path="{{path}}"
                  data-title="{{label}}"
                  title="Display on the Token Layer"
                  aria-label="Display {{label}} on the Token Layer"
                >
                  <i class="fas fa-layer-group" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <div class="mg-name" title="{{label}}">{{label}}</div>
          </article>
        {{/inline}}

        {{#if visibleFiles.length}}
          <div class="mg-grid">
            {{#each visibleFiles as |file|}}
              {{> thumbCard file}}
            {{/each}}
          </div>
        {{else}}
          <div class="mg-empty">
            <div class="mg-empty-icon">
              <i class="fas {{#if filter}}fa-magnifying-glass{{else}}fa-image{{/if}}" aria-hidden="true"></i>
            </div>
            <h3>{{#if filter}}No matching images{{else}}This folder is empty{{/if}}</h3>
            <p>
              {{#if filter}}
                Try a different search or clear the current one.
              {{else}}
                Choose another folder or add images here.
              {{/if}}
            </p>
          </div>
        {{/if}}
      </div>

      <footer class="mg-content-footer">
        <div class="mg-stats">
          <span>{{totalFiltered}} {{#if filter}}matching{{else}}image{{#unless singleFiltered}}s{{/unless}}{{/if}}</span>
          {{#if canLoadMore}}<span>• {{showing}} shown</span>{{/if}}
        </div>

        {{#if canLoadMore}}
          <button type="button" data-action="load-more">
            Load more
          </button>
        {{/if}}
      </footer>
    </main>

    {{#if selectedImage}}
      <aside class="mg-inspector" aria-label="Selected image details">
        <header class="mg-inspector-header">
          <div>
            <i class="fas fa-image" aria-hidden="true"></i>
            <span>Scene Details</span>
          </div>
          <button
            type="button"
            data-action="close-image-inspector"
            title="Close details"
            aria-label="Close image details"
          >
            <i class="fas fa-xmark" aria-hidden="true"></i>
          </button>
        </header>

        <div class="mg-inspector-scroll">
          <img
            class="mg-inspector-preview"
            src="{{selectedImage.url}}"
            alt="{{selectedImage.label}}"
          >
          <div class="mg-inspector-path" title="{{selectedImage.path}}">
            {{selectedImage.path}}
          </div>

          <form
            class="mg-inspector-form"
            data-role="image-details-form"
            data-path="{{selectedImage.path}}"
          >
            <label>
              <span>Name</span>
              <input
                type="text"
                name="title"
                value="{{selectedImage.customTitle}}"
                placeholder="{{selectedImage.fileName}}"
                maxlength="200"
                autocomplete="off"
              >
            </label>

            <label>
              <span>Description</span>
              <textarea
                name="description"
                rows="6"
                maxlength="5000"
                placeholder="Add notes about this scene"
              >{{selectedImage.description}}</textarea>
            </label>

            <div class="mg-preset-heading">
              <span>Scene preset</span>
              <button
                type="button"
                data-action="copy-scene-preset"
                title="Copy all supported settings from the active Scene"
                {{#unless selectedSceneAvailable}}disabled{{/unless}}
              >
                <i class="fas fa-camera" aria-hidden="true"></i>
                Copy Current
              </button>
            </div>

            <details class="mg-preset-section" open>
              <summary>Grid</summary>
              <div class="mg-preset-fields">
                <label class="is-full">
                  <span>Grid type</span>
                  <select name="gridType">
                    {{#each selectedImage.scenePresetForm.gridTypeOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                        {{option.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>

                <label>
                  <span>Size</span>
                  <div class="mg-inspector-grid-input">
                    <input
                      type="number"
                      name="gridSize"
                      value="{{selectedImage.scenePresetForm.gridSize}}"
                      min="{{imageGridSizeMin}}"
                      max="{{imageGridSizeMax}}"
                      step="{{imageGridSizeStep}}"
                      placeholder="Keep"
                    >
                    <span>px</span>
                  </div>
                </label>

                <label>
                  <span>Distance</span>
                  <input
                    type="number"
                    name="gridDistance"
                    value="{{selectedImage.scenePresetForm.gridDistance}}"
                    min="0.01"
                    step="0.01"
                    placeholder="Keep"
                  >
                </label>

                <label>
                  <span>Units</span>
                  <input
                    type="text"
                    name="gridUnits"
                    value="{{selectedImage.scenePresetForm.gridUnits}}"
                    maxlength="30"
                    placeholder="Keep"
                  >
                </label>

                <label>
                  <span>Line color</span>
                  <input
                    type="text"
                    name="gridColor"
                    value="{{selectedImage.scenePresetForm.gridColor}}"
                    pattern="#[0-9a-fA-F]{6}"
                    placeholder="#000000"
                  >
                </label>

                <label class="is-full">
                  <span>Line opacity</span>
                  <input
                    type="number"
                    name="gridAlpha"
                    value="{{selectedImage.scenePresetForm.gridAlpha}}"
                    min="0"
                    max="1"
                    step="0.05"
                    placeholder="Keep current"
                  >
                </label>
              </div>
            </details>

            <details class="mg-preset-section">
              <summary>Vision & Environment</summary>
              <div class="mg-preset-fields">
                <label>
                  <span>Darkness</span>
                  <input
                    type="number"
                    name="darkness"
                    value="{{selectedImage.scenePresetForm.darkness}}"
                    min="0"
                    max="1"
                    step="0.05"
                    placeholder="Keep"
                  >
                </label>

                <label>
                  <span>Padding</span>
                  <input
                    type="number"
                    name="padding"
                    value="{{selectedImage.scenePresetForm.padding}}"
                    min="0"
                    max="0.5"
                    step="0.05"
                    placeholder="Keep"
                  >
                </label>

                <label class="is-full">
                  <span>Token vision</span>
                  <select name="tokenVision">
                    {{#each selectedImage.scenePresetForm.tokenVisionOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                        {{option.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>

                <label class="is-full">
                  <span>Fog exploration</span>
                  <select name="fogExploration">
                    {{#each selectedImage.scenePresetForm.fogExplorationOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                        {{option.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>

                <label class="is-full">
                  <span>Weather</span>
                  <select name="weather">
                    {{#each selectedImage.scenePresetForm.weatherOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                        {{option.label}}
                      </option>
                    {{/each}}
                  </select>
                </label>

                <label class="is-full">
                  <span>Background color</span>
                  <input
                    type="text"
                    name="backgroundColor"
                    value="{{selectedImage.scenePresetForm.backgroundColor}}"
                    pattern="#[0-9a-fA-F]{6}"
                    placeholder="#000000"
                  >
                </label>
              </div>
              <small class="mg-preset-warning">
                Changing Scene padding can reposition placed canvas elements.
              </small>
            </details>

            <details class="mg-preset-section">
              <summary>Initial View</summary>
              <div class="mg-preset-fields">
                <label>
                  <span>Center X</span>
                  <input
                    type="number"
                    name="initialX"
                    value="{{selectedImage.scenePresetForm.initialX}}"
                    step="1"
                    placeholder="Keep"
                  >
                </label>

                <label>
                  <span>Center Y</span>
                  <input
                    type="number"
                    name="initialY"
                    value="{{selectedImage.scenePresetForm.initialY}}"
                    step="1"
                    placeholder="Keep"
                  >
                </label>

                <label class="is-full">
                  <span>Zoom</span>
                  <input
                    type="number"
                    name="initialScale"
                    value="{{selectedImage.scenePresetForm.initialScale}}"
                    min="0.1"
                    max="3"
                    step="0.05"
                    placeholder="Keep current"
                  >
                </label>
              </div>
            </details>

            <small class="mg-preset-note">
              Blank values preserve the active Scene setting. Saved values are applied before display.
            </small>

            <div class="mg-inspector-actions">
              <button type="submit">
                <i class="fas fa-floppy-disk" aria-hidden="true"></i>
                Save
              </button>
              <button
                type="button"
                data-action="add-to-token-layer"
                data-path="{{selectedImage.path}}"
                data-title="{{selectedImage.label}}"
              >
                <i class="fas fa-layer-group" aria-hidden="true"></i>
                Display
              </button>
            </div>
          </form>
        </div>
      </aside>
    {{/if}}
  </div>

  <dialog class="mg-image-preview" data-role="image-preview" aria-labelledby="mg-image-preview-title">
    <div class="mg-image-preview-frame">
      <header class="mg-image-preview-header">
        <div class="mg-image-preview-heading">
          <strong id="mg-image-preview-title" data-role="image-preview-title">Image preview</strong>
          <span data-role="image-preview-path"></span>
        </div>
        <button
          type="button"
          class="mg-image-preview-close"
          data-role="image-preview-close"
          aria-label="Close image preview"
          title="Close preview"
        >
          <i class="fas fa-xmark" aria-hidden="true"></i>
        </button>
      </header>
      <div class="mg-image-preview-canvas">
        <img data-role="image-preview-image" alt="">
      </div>
    </div>
  </dialog>
</div>
