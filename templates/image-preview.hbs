{{#if image}}
  <figure class="mg-large-preview">
    <div class="mg-large-preview-media">
      {{#if image.isVideo}}
        <video
          src="{{image.url}}"
          aria-label="{{image.label}}"
          autoplay
          muted
          loop
          playsinline
          controls
          preload="auto"
        ></video>
      {{else}}
        <img src="{{image.url}}" alt="{{image.label}}">
      {{/if}}
    </div>
    <figcaption>
      <strong>{{image.label}}</strong>
      <span title="{{image.path}}">{{image.path}}</span>
    </figcaption>
  </figure>
{{else}}
  <div class="mg-large-preview-missing">
    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
    <span>This scene preview is no longer available.</span>
  </div>
{{/if}}
