<div class="mg-floating-toolbar-controls">
  <button type="button" data-action="open-map" title="Open Scene Maps" aria-label="Open Scene Maps">
    <i class="fas fa-diagram-project" aria-hidden="true"></i>
  </button>
  <span class="mg-floating-toolbar-divider" aria-hidden="true"></span>
  <button type="button" data-action="open-gallery" title="Open Scene Gallery" aria-label="Open Scene Gallery">
    <i class="fas fa-images" aria-hidden="true"></i>
  </button>
  {{#if hasActors}}
    <button type="button" data-action="open-actors" title="Open MK Actors" aria-label="Open MK Actors">
      <i class="fas fa-users" aria-hidden="true"></i>
    </button>
  {{/if}}
  <span class="mg-floating-toolbar-divider" aria-hidden="true"></span>
  <label class="mg-floating-toolbar-grid" data-role="grid-size-control" title="{{grid.title}}">
    <i class="fas fa-border-all" aria-hidden="true"></i>
    <span class="sr-only">Battle grid size in pixels</span>
    <input type="range" data-role="grid-size" min="{{grid.min}}" max="{{grid.max}}"
      step="{{grid.step}}" value="{{grid.value}}" aria-label="Battle grid size in pixels"
      {{#if grid.disabled}}disabled{{/if}}>
    <span class="mg-floating-grid-reading"><output data-role="grid-size-value">{{grid.label}}</output><small>px</small></span>
  </label>
</div>
