<div class="mg-floating-toolbar-controls">
  <button type="button" class="mg-floating-toolbar-handle" data-role="toolbar-handle"
    title="Drag to move toolbar. Arrow keys move it; Shift moves faster." aria-label="Move Scene Map toolbar">
    <i class="fas fa-grip-vertical" aria-hidden="true"></i>
  </button>
  <label class="mg-floating-map-picker">
    <i class="fas fa-diagram-project" aria-hidden="true"></i>
    <span class="sr-only">Scene Map</span>
    <select aria-label="Scene Map" title="Choose a Scene Map to open" {{#unless hasMaps}}disabled{{/unless}}>
      {{#each maps}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
      {{else}}
        <option value="">No Scene Maps yet</option>
      {{/each}}
    </select>
  </label>
  <button type="button" data-action="open-map" title="Open Scene Maps" aria-label="Open selected Scene Map">
    <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i><span>Open</span>
  </button>
  <span class="mg-floating-toolbar-divider" aria-hidden="true"></span>
  <button type="button" data-action="open-gallery" title="Open Scene Gallery">
    <i class="fas fa-images" aria-hidden="true"></i><span>Gallery</span>
  </button>
  {{#if hasActors}}
    <button type="button" data-action="open-actors" title="Open MK Actors">
      <i class="fas fa-users" aria-hidden="true"></i><span>MK Actors</span>
    </button>
  {{/if}}
</div>
