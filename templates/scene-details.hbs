<div class="mg-inspector mg-scene-details" aria-label="Selected image details">
  {{#if selectedImage}}
    <div class="mg-scene-details-layout">
      <nav
        class="mg-scene-details-section-nav"
        role="tablist"
        aria-orientation="vertical"
        aria-label="Scene settings sections"
      >
          <button
            type="button"
            id="mg-scene-details-tab-basics"
            role="tab"
            data-role="settings-tab"
            data-action="open-settings-section"
            data-section="basics"
            aria-selected="true"
            aria-controls="mg-scene-details-section-basics"
            tabindex="0"
            title="Open Basics settings"
            aria-label="Open Basics settings"
          >
            <i class="fas fa-circle-info" aria-hidden="true"></i>
            <span class="mg-scene-details-nav-label">Basics</span>
          </button>
          <button
            type="button"
            id="mg-scene-details-tab-grid"
            role="tab"
            data-role="settings-tab"
            data-action="open-settings-section"
            data-section="grid"
            aria-selected="false"
            aria-controls="mg-scene-details-section-grid"
            tabindex="-1"
            title="Open Grid settings"
            aria-label="Open Grid settings"
          >
            <i class="fas fa-border-all" aria-hidden="true"></i>
            <span class="mg-scene-details-nav-label">Grid</span>
          </button>
          <button
            type="button"
            id="mg-scene-details-tab-light-sources"
            role="tab"
            data-role="settings-tab"
            data-action="open-settings-section"
            data-section="light-sources"
            aria-selected="false"
            aria-controls="mg-scene-details-section-light-sources"
            tabindex="-1"
            title="Open Light Sources settings"
            aria-label="Open Light Sources settings"
          >
            <i class="fas fa-lightbulb" aria-hidden="true"></i>
            <span class="mg-scene-details-nav-label">Lights</span>
          </button>
          <button
            type="button"
            id="mg-scene-details-tab-vision"
            role="tab"
            data-role="settings-tab"
            data-action="open-settings-section"
            data-section="vision"
            aria-selected="false"
            aria-controls="mg-scene-details-section-vision"
            tabindex="-1"
            title="Open Vision settings"
            aria-label="Open Vision settings"
          >
            <i class="fas fa-eye" aria-hidden="true"></i>
            <span class="mg-scene-details-nav-label">Vision</span>
          </button>
          <button
            type="button"
            id="mg-scene-details-tab-journal"
            role="tab"
            data-role="settings-tab"
            data-action="open-settings-section"
            data-section="journal"
            aria-selected="false"
            aria-controls="mg-scene-details-section-journal"
            tabindex="-1"
            title="Open Journal settings"
            aria-label="Open Journal settings"
          >
            <i class="fas fa-book-open" aria-hidden="true"></i>
            <span class="mg-scene-details-nav-label">Journal</span>
          </button>
          <button
            type="button"
            id="mg-scene-details-tab-audio"
            role="tab"
            data-role="settings-tab"
            data-action="open-settings-section"
            data-section="audio"
            aria-selected="false"
            aria-controls="mg-scene-details-section-audio"
            tabindex="-1"
            title="Open Audio settings"
            aria-label="Open Audio settings"
          >
            <i class="fas fa-volume-high" aria-hidden="true"></i>
            <span class="mg-scene-details-nav-label">Audio</span>
          </button>
      </nav>

      <div class="mg-scene-details-body">
        <div class="mg-inspector-scroll">

        <div class="mg-scene-details-hero">
          <div class="mg-inspector-preview-frame">
            {{#if selectedImage.isVideo}}
              <video
                class="mg-inspector-preview mg-video"
                src="{{selectedImage.url}}"
                aria-label="{{selectedImage.label}}"
                autoplay
                muted
                loop
                playsinline
                controls
                preload="metadata"
              ></video>
            {{else}}
              <img
                class="mg-inspector-preview"
                src="{{selectedImage.url}}"
                alt="{{selectedImage.label}}"
                loading="eager"
                decoding="async"
              >
            {{/if}}
          </div>
          <div class="mg-scene-details-badges" aria-label="Media status">
            <span class="mg-scene-details-badge">{{#if selectedImage.isVideo}}Video{{else}}Image{{/if}}</span>
            {{#if selectedImage.hasScenePreset}}
              <span class="mg-scene-details-badge is-accent">Preset saved</span>
            {{/if}}
            {{#if selectedImage.hasMetadata}}
              <span class="mg-scene-details-badge">Metadata saved</span>
            {{/if}}
          </div>
        </div>

      <form
        id="mg-scene-details-form"
        class="mg-inspector-form"
        data-role="image-details-form"
        data-path="{{selectedImage.path}}"
      >
        <section
          id="mg-scene-details-section-basics"
          role="tabpanel"
          aria-labelledby="mg-scene-details-tab-basics"
          data-role="settings-section"
          data-section="basics"
          class="mg-preset-section mg-settings-panel is-active"
          aria-hidden="false"
        >
          <h3 class="mg-settings-panel-title">Basics</h3>
          <div class="mg-preset-fields">
            <label class="is-full">
              <span>Name</span>
              <input
                type="text"
                name="title"
                value="{{selectedImage.customTitle}}"
                placeholder="{{selectedImage.fileName}}"
                maxlength="200"
                autocomplete="off"
              >
            </label>

            <label class="is-full">
              <span>Tags</span>
              <input
                type="text"
                name="tags"
                value="{{selectedImage.tagsText}}"
                maxlength="1000"
                placeholder="town, combat, night, interior"
                autocomplete="off"
              >
              <small>Separate tags with commas. Tags are saved in lowercase.</small>
            </label>

            <div
              class="mg-preset-form-row mg-initial-view-position"
              role="group"
              aria-labelledby="mg-initial-view-position-label"
            >
              <span id="mg-initial-view-position-label" class="mg-preset-row-label">
                Initial View Position
              </span>
              <div class="mg-initial-view-controls">
                <button
                  type="button"
                  class="mg-initial-view-copy"
                  data-action="copy-scene-preset"
                  data-preset-section="initial-view"
                  title="Copy the Initial View position from the active Scene"
                  aria-label="Copy the Initial View position from the active Scene"
                  {{#unless selectedSceneAvailable}}disabled{{/unless}}
                >
                  <i class="fas fa-arrows-to-circle" aria-hidden="true"></i>
                </button>
                <label>
                  <span>X</span>
                  <input
                    type="number"
                    name="initialX"
                    value="{{selectedImage.scenePresetForm.initialX}}"
                    step="1"
                    placeholder="Keep"
                    aria-label="Initial View X position"
                  >
                </label>
                <label>
                  <span>Y</span>
                  <input
                    type="number"
                    name="initialY"
                    value="{{selectedImage.scenePresetForm.initialY}}"
                    step="1"
                    placeholder="Keep"
                    aria-label="Initial View Y position"
                  >
                </label>
                <label class="mg-initial-view-zoom">
                  <span>Zoom</span>
                  <input
                    type="number"
                    name="initialScale"
                    value="{{selectedImage.scenePresetForm.initialScale}}"
                    min="0.1"
                    max="3"
                    step="0.01"
                    placeholder="Keep"
                    aria-label="Initial View zoom"
                  >
                </label>
              </div>
              <small>
                Set the default camera position shown the first time this Scene is viewed.
              </small>
            </div>
          </div>
        </section>

        <section
          id="mg-scene-details-section-grid"
          role="tabpanel"
          aria-labelledby="mg-scene-details-tab-grid"
          data-role="settings-section"
          data-section="grid"
          class="mg-preset-section mg-settings-panel"
          aria-hidden="true"
          hidden
        >
          <div class="mg-settings-panel-heading">
            <h3 class="mg-settings-panel-title">Grid</h3>
            <button
              type="button"
              class="mg-copy-section"
              data-action="copy-scene-preset"
              data-preset-section="grid"
              title="Copy Grid settings from the active Scene"
              {{#unless selectedSceneAvailable}}disabled{{/unless}}
            >
              <i class="fas fa-copy" aria-hidden="true"></i>
              <span>Copy Current Scene</span>
            </button>
          </div>
          <div class="mg-preset-fields">
            <label class="is-full">
              <span>Grid type</span>
              <select name="gridType">
                {{#each selectedImage.scenePresetForm.gridTypeOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label>
              <span>Size</span>
              <div class="mg-inspector-grid-input">
                <input
                  type="number"
                  name="gridSize"
                  value="{{selectedImage.scenePresetForm.gridSize}}"
                  min="{{imageGridSizeMin}}"
                  max="{{imageGridSizeMax}}"
                  step="{{imageGridSizeStep}}"
                  placeholder="Keep"
                >
                <span>px</span>
              </div>
            </label>

            <label>
              <span>Distance</span>
              <input
                type="number"
                name="gridDistance"
                value="{{selectedImage.scenePresetForm.gridDistance}}"
                min="0.01"
                step="0.01"
                placeholder="Keep"
              >
            </label>

            <label>
              <span>Units</span>
              <input
                type="text"
                name="gridUnits"
                value="{{selectedImage.scenePresetForm.gridUnits}}"
                maxlength="30"
                placeholder="Keep"
              >
            </label>

            <label>
              <span>Line color</span>
              <input
                type="text"
                name="gridColor"
                value="{{selectedImage.scenePresetForm.gridColor}}"
                pattern="#[0-9a-fA-F]{6}"
                placeholder="#000000"
              >
            </label>

            <label class="is-full">
              <span>Line opacity</span>
              <input
                type="number"
                name="gridAlpha"
                value="{{selectedImage.scenePresetForm.gridAlpha}}"
                min="0"
                max="1"
                step="0.05"
                placeholder="Keep current"
              >
            </label>
          </div>
        </section>

        <section
          id="mg-scene-details-section-light-sources"
          role="tabpanel"
          aria-labelledby="mg-scene-details-tab-light-sources"
          data-role="settings-section"
          data-section="light-sources"
          class="mg-preset-section mg-settings-panel"
          aria-hidden="true"
          hidden
        >
          <div class="mg-settings-panel-heading">
            <h3 class="mg-settings-panel-title">Light Sources</h3>
            <button
              type="button"
              class="mg-copy-section"
              data-action="copy-scene-preset"
              data-preset-section="light-sources"
              title="Copy Light Sources from the active Scene"
              {{#unless selectedSceneAvailable}}disabled{{/unless}}
            >
              <i class="fas fa-copy" aria-hidden="true"></i>
              <span>Copy Current Scene</span>
            </button>
          </div>
          <div class="mg-preset-fields">
            <label class="is-full mg-light-source-summary">
              <span>Stored sources</span>
              <output data-role="light-source-summary">{{selectedImage.scenePresetForm.lightSourcesSummary}}</output>
            </label>
          </div>
          <input
            type="hidden"
            name="lightSources"
            value="{{selectedImage.scenePresetForm.lightSourcesJson}}"
          >
          <small class="mg-linked-note">
            Copy Current Scene captures all Ambient Light sources from the active Scene. Applying this preset replaces the Scene's current light sources.
          </small>
        </section>

        <section
          id="mg-scene-details-section-vision"
          role="tabpanel"
          aria-labelledby="mg-scene-details-tab-vision"
          data-role="settings-section"
          data-section="vision"
          class="mg-preset-section mg-settings-panel"
          aria-hidden="true"
          hidden
        >
          <div class="mg-settings-panel-heading">
            <h3 class="mg-settings-panel-title">Vision</h3>
            <button
              type="button"
              class="mg-copy-section"
              data-action="copy-scene-preset"
              data-preset-section="vision"
              title="Copy Vision settings from the active Scene"
              {{#unless selectedSceneAvailable}}disabled{{/unless}}
            >
              <i class="fas fa-copy" aria-hidden="true"></i>
              <span>Copy Current Scene</span>
            </button>
          </div>
          <div class="mg-preset-fields">
            <label class="mg-slider-field">
              <span>Darkness</span>
              <div
                class="mg-preset-slider"
                data-role="preset-slider"
                data-field="darkness"
                data-fallback="0"
                data-empty-label="Keep current"
              >
                <input
                  type="range"
                  data-role="slider-range"
                  min="0"
                  max="1"
                  step="0.05"
                  aria-label="Darkness"
                >
                <output data-role="slider-output">Keep current</output>
                <button
                  type="button"
                  data-role="slider-reset"
                  title="Keep the current Scene darkness"
                  aria-label="Keep the current Scene darkness"
                >
                  <i class="fas fa-rotate-left" aria-hidden="true"></i>
                </button>
              </div>
              <input
                type="hidden"
                name="darkness"
                value="{{selectedImage.scenePresetForm.darkness}}"
              >
            </label>

            <label class="mg-slider-field">
              <span>Padding</span>
              <div
                class="mg-preset-slider"
                data-role="preset-slider"
                data-field="padding"
                data-fallback="0.25"
                data-empty-label="Keep current"
              >
                <input
                  type="range"
                  data-role="slider-range"
                  min="0"
                  max="0.5"
                  step="0.05"
                  aria-label="Padding"
                >
                <output data-role="slider-output">Keep current</output>
                <button
                  type="button"
                  data-role="slider-reset"
                  title="Keep the current Scene padding"
                  aria-label="Keep the current Scene padding"
                >
                  <i class="fas fa-rotate-left" aria-hidden="true"></i>
                </button>
              </div>
              <input
                type="hidden"
                name="padding"
                value="{{selectedImage.scenePresetForm.padding}}"
              >
            </label>

            <label class="is-full">
              <span>Token vision</span>
              <select name="tokenVision">
                {{#each selectedImage.scenePresetForm.tokenVisionOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full">
              <span>Fog exploration</span>
              <select name="fogExploration">
                {{#each selectedImage.scenePresetForm.fogExplorationOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full">
              <span>Weather</span>
              <select name="weather">
                {{#each selectedImage.scenePresetForm.weatherOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

          </div>
        </section>

        <section
          id="mg-scene-details-section-journal"
          role="tabpanel"
          aria-labelledby="mg-scene-details-tab-journal"
          data-role="settings-section"
          data-section="journal"
          class="mg-preset-section mg-settings-panel"
          aria-hidden="true"
          hidden
        >
          <h3 class="mg-settings-panel-title">Journal</h3>
          <div class="mg-preset-fields">
            <label class="is-full">
              <span>Journal entry</span>
              <div class="mg-document-drop" data-role="document-drop" data-drop-type="journal">
                <div class="mg-document-select-row">
                  <select name="journal" aria-label="Journal entry">
                    {{#each selectedImage.scenePresetForm.journalOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                        {{option.label}}
                      </option>
                    {{/each}}
                  </select>
                  <button
                    type="button"
                    class="mg-clear-selection"
                    data-action="clear-linked-selection"
                    data-field="journal"
                    title="Clear Journal Entry selection"
                    aria-label="Clear Journal Entry selection"
                  >
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                  </button>
                </div>
                <small class="mg-drop-hint">Drop a Journal Entry here, or choose one from the list.</small>
              </div>
            </label>
          </div>
          <small class="mg-linked-note">
            The selected Journal Entry opens automatically when this image is displayed.
          </small>
        </section>

        <section
          id="mg-scene-details-section-audio"
          role="tabpanel"
          aria-labelledby="mg-scene-details-tab-audio"
          data-role="settings-section"
          data-section="audio"
          class="mg-preset-section mg-settings-panel"
          aria-hidden="true"
          hidden
        >
          <h3 class="mg-settings-panel-title">Audio</h3>
          <div class="mg-preset-fields">
            <label class="is-full">
              <span>Playlist sound</span>
              <div class="mg-document-drop" data-role="document-drop" data-drop-type="playlist">
                <div class="mg-document-select-row">
                  <select name="playlistSoundLink" aria-label="Playlist sound">
                    {{#each selectedImage.scenePresetForm.playlistSoundOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                        {{option.label}}
                      </option>
                    {{/each}}
                  </select>
                  <button
                    type="button"
                    class="mg-clear-selection"
                    data-action="clear-linked-selection"
                    data-field="playlistSoundLink"
                    title="Clear Playlist selection"
                    aria-label="Clear Playlist selection"
                  >
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                  </button>
                </div>
                <small class="mg-drop-hint">Drop a Playlist or Playlist Sound here, or choose one from the list.</small>
              </div>
            </label>
          </div>
          <small class="mg-linked-note">
            The selected Playlist or Playlist Sound starts automatically when this image is displayed.
          </small>
        </section>

        </form>
        </div>
        <footer class="mg-scene-details-footer" aria-label="Scene Details actions">
          <div class="mg-scene-details-status" data-role="dirty-indicator" aria-live="polite" hidden>
            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
            <span>Unsaved changes</span>
          </div>
          <div class="mg-scene-details-footer-actions">
            <button
              type="submit"
              form="mg-scene-details-form"
              class="mg-scene-details-primary"
              data-role="save-details"
              title="Save image details"
              aria-label="Save image details"
              disabled
            >
              <i class="fas fa-floppy-disk" aria-hidden="true"></i>
              <span>Save</span>
            </button>
            <button
              type="button"
              data-action="set-scene-background"
              data-path="{{selectedImage.path}}"
              data-title="{{selectedImage.label}}"
              title="Display image on the active Scene"
              aria-label="Display image on the active Scene"
            >
              <i class="fas fa-image" aria-hidden="true"></i>
              <span>Set Background</span>
            </button>
            <button
              type="button"
              class="mg-clear-metadata"
              data-action="clear-image-metadata"
              data-path="{{selectedImage.path}}"
              title="Clear the saved name, description, and Scene preset"
              aria-label="Clear image details"
              {{#unless selectedImage.hasMetadata}}disabled{{/unless}}
            >
              <i class="fas fa-eraser" aria-hidden="true"></i>
              <span>Clear</span>
            </button>
          </div>
        </footer>
      </div>
    </div>
  {{else}}
    <div class="mg-empty" role="status">
      <div class="mg-empty-icon">
        <i class="fas fa-image" aria-hidden="true"></i>
      </div>
      <h3>Image unavailable</h3>
      <p>The selected image is no longer available in the gallery.</p>
    </div>
  {{/if}}
</div>
