{{#if selectedImage}}
  <div class="mg-image-details-window">
    <div class="mg-image-details-heading">
      <div>
        <i class="fas fa-map" aria-hidden="true"></i>
        <strong>{{selectedImage.label}}</strong>
      </div>
      <span title="{{selectedImage.path}}">{{selectedImage.path}}</span>
    </div>

    <div class="mg-image-details-scroll">
      {{#if selectedImage.isVideo}}
        <video
          class="mg-image-details-preview mg-video"
          src="{{selectedImage.url}}"
          aria-label="{{selectedImage.label}}"
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
        ></video>
      {{else}}
        <img
          class="mg-image-details-preview"
          src="{{selectedImage.url}}"
          alt="{{selectedImage.label}}"
        >
      {{/if}}

      <form
        class="mg-inspector-form"
        data-role="image-details-form"
        data-path="{{selectedImage.path}}"
      >
        <label>
          <span>Name</span>
          <input
            type="text"
            name="title"
            value="{{selectedImage.customTitle}}"
            placeholder="{{selectedImage.fileName}}"
            maxlength="200"
            autocomplete="off"
          >
        </label>

        <label>
          <span>Description</span>
          <textarea
            name="description"
            rows="6"
            maxlength="5000"
            placeholder="Add notes about this scene"
          >{{selectedImage.description}}</textarea>
        </label>

        <label>
          <span>Tags</span>
          <input
            type="text"
            name="tags"
            value="{{selectedImage.tagsText}}"
            maxlength="1000"
            placeholder="town, combat, night, interior"
            autocomplete="off"
          >
          <small>Separate tags with commas. Tags are saved in lowercase.</small>
        </label>

        <div class="mg-preset-heading">
          <span>Scene preset</span>
          <button
            type="button"
            data-action="copy-scene-preset"
            title="Copy all supported settings from the active Scene"
            {{#unless selectedSceneAvailable}}disabled{{/unless}}
          >
            <i class="fas fa-camera" aria-hidden="true"></i>
            Copy Current
          </button>
        </div>

        <details class="mg-preset-section" open>
          <summary>Grid</summary>
          <div class="mg-preset-fields">
            <label class="is-full">
              <span>Grid type</span>
              <select name="gridType">
                {{#each selectedImage.scenePresetForm.gridTypeOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label>
              <span>Size</span>
              <div class="mg-inspector-grid-input">
                <input
                  type="number"
                  name="gridSize"
                  value="{{selectedImage.scenePresetForm.gridSize}}"
                  min="{{imageGridSizeMin}}"
                  max="{{imageGridSizeMax}}"
                  step="{{imageGridSizeStep}}"
                  placeholder="Keep"
                >
                <span>px</span>
              </div>
            </label>

            <label>
              <span>Distance</span>
              <input
                type="number"
                name="gridDistance"
                value="{{selectedImage.scenePresetForm.gridDistance}}"
                min="0.01"
                step="0.01"
                placeholder="Keep"
              >
            </label>

            <label>
              <span>Units</span>
              <input
                type="text"
                name="gridUnits"
                value="{{selectedImage.scenePresetForm.gridUnits}}"
                maxlength="30"
                placeholder="Keep"
              >
            </label>

            <label>
              <span>Line color</span>
              <input
                type="text"
                name="gridColor"
                value="{{selectedImage.scenePresetForm.gridColor}}"
                pattern="#[0-9a-fA-F]{6}"
                placeholder="#000000"
              >
            </label>

            <label class="is-full">
              <span>Line opacity</span>
              <input
                type="number"
                name="gridAlpha"
                value="{{selectedImage.scenePresetForm.gridAlpha}}"
                min="0"
                max="1"
                step="0.05"
                placeholder="Keep current"
              >
            </label>
          </div>
        </details>

        <details class="mg-preset-section">
          <summary>Vision & Environment</summary>
          <div class="mg-preset-fields">
            <label>
              <span>Darkness</span>
              <input
                type="number"
                name="darkness"
                value="{{selectedImage.scenePresetForm.darkness}}"
                min="0"
                max="1"
                step="0.05"
                placeholder="Keep"
              >
            </label>

            <label>
              <span>Padding</span>
              <input
                type="number"
                name="padding"
                value="{{selectedImage.scenePresetForm.padding}}"
                min="0"
                max="0.5"
                step="0.05"
                placeholder="Keep"
              >
            </label>

            <label class="is-full">
              <span>Token vision</span>
              <select name="tokenVision">
                {{#each selectedImage.scenePresetForm.tokenVisionOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full">
              <span>Fog exploration</span>
              <select name="fogExploration">
                {{#each selectedImage.scenePresetForm.fogExplorationOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full">
              <span>Weather</span>
              <select name="weather">
                {{#each selectedImage.scenePresetForm.weatherOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full">
              <span>Background color</span>
              <input
                type="color"
                name="backgroundColor"
                value="{{selectedImage.scenePresetForm.backgroundColorValue}}"
                {{#unless selectedImage.scenePresetForm.backgroundColorEnabled}}disabled{{/unless}}
              >
            </label>

            <label class="is-full mg-linked-action">
              <input
                type="checkbox"
                name="useBackgroundColor"
                value="true"
                {{#if selectedImage.scenePresetForm.backgroundColorEnabled}}checked{{/if}}
              >
              <span class="mg-linked-toggle" aria-hidden="true"></span>
              <span class="mg-linked-action-text">Set background color when displayed</span>
            </label>
          </div>
          <small class="mg-preset-warning">
            Changing Scene padding can reposition placed canvas elements.
          </small>
        </details>

        <details class="mg-preset-section">
          <summary>Journal & Audio</summary>
          <div class="mg-preset-fields">
            <label class="is-full">
              <span>Journal entry</span>
              <select name="journal">
                {{#each selectedImage.scenePresetForm.journalOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full mg-linked-action">
              <input
                type="checkbox"
                name="openJournal"
                value="true"
                {{#if selectedImage.scenePresetForm.openJournal}}checked{{/if}}
                {{#if selectedImage.scenePresetForm.journalActionDisabled}}disabled{{/if}}
              >
              <span class="mg-linked-toggle" aria-hidden="true"></span>
              <span class="mg-linked-action-text">Open Journal when displayed</span>
            </label>

            <label class="is-full">
              <span>Playlist sound</span>
              <select name="playlistSoundLink">
                {{#each selectedImage.scenePresetForm.playlistSoundOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>
                    {{option.label}}
                  </option>
                {{/each}}
              </select>
            </label>

            <label class="is-full mg-linked-action">
              <input
                type="checkbox"
                name="startPlaylistSound"
                value="true"
                {{#if selectedImage.scenePresetForm.startPlaylistSound}}checked{{/if}}
                {{#if selectedImage.scenePresetForm.playlistActionDisabled}}disabled{{/if}}
              >
              <span class="mg-linked-toggle" aria-hidden="true"></span>
              <span class="mg-linked-action-text">Start audio when displayed</span>
            </label>
          </div>
          <small class="mg-linked-note">
            Associations are saved to the active Scene before optional Journal or audio actions run.
          </small>
        </details>

        <details class="mg-preset-section">
          <summary>Initial View</summary>
          <div class="mg-preset-fields">
            <label>
              <span>Center X</span>
              <input
                type="number"
                name="initialX"
                value="{{selectedImage.scenePresetForm.initialX}}"
                step="1"
                placeholder="Keep"
              >
            </label>

            <label>
              <span>Center Y</span>
              <input
                type="number"
                name="initialY"
                value="{{selectedImage.scenePresetForm.initialY}}"
                step="1"
                placeholder="Keep"
              >
            </label>

            <label class="is-full">
              <span>Zoom</span>
              <input
                type="number"
                name="initialScale"
                value="{{selectedImage.scenePresetForm.initialScale}}"
                min="0.1"
                max="3"
                step="0.01"
                placeholder="Keep current"
              >
            </label>
          </div>
        </details>

        <small class="mg-preset-note">
          Blank values preserve the active Scene setting. Saved values are applied before display.
        </small>

        <div class="mg-inspector-actions">
          <button type="submit">
            <i class="fas fa-floppy-disk" aria-hidden="true"></i>
            Save
          </button>
          <button
            type="button"
            data-action="add-to-token-layer"
            data-path="{{selectedImage.path}}"
            data-title="{{selectedImage.label}}"
          >
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            Display
          </button>
          <button
            type="button"
            class="mg-favorite-toggle {{#if selectedImage.favorite}}is-favorite{{/if}}"
            data-action="toggle-favorite"
            data-path="{{selectedImage.path}}"
            data-title="{{selectedImage.label}}"
            aria-pressed="{{#if selectedImage.favorite}}true{{else}}false{{/if}}"
          >
            <i class="{{#if selectedImage.favorite}}fas{{else}}far{{/if}} fa-star" aria-hidden="true"></i>
            {{#if selectedImage.favorite}}Favorited{{else}}Favorite{{/if}}
          </button>
          <button
            type="button"
            class="mg-clear-metadata"
            data-action="clear-image-metadata"
            data-path="{{selectedImage.path}}"
            title="Clear the saved name, description, tags, and Scene preset"
            {{#unless selectedImage.hasMetadata}}disabled{{/unless}}
          >
            <i class="fas fa-eraser" aria-hidden="true"></i>
            Clear
          </button>
        </div>
      </form>
    </div>
  </div>
{{else}}
  <div class="mg-image-details-missing">
    <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
    <span>The selected image is no longer available.</span>
  </div>
{{/if}}
